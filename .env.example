# Copy to .env (never commit it) and fill in. Loaded by backend/run.sh. Only these variables are read by the backend.
GROQ_API_KEY=
NEWSDATA_API_KEY=

# --- optional ---
# PORT=8080
# BIND_HOST=127.0.0.1                 # keep loopback unless you add authentication/TLS in front
# GROQ_MODEL=openai/gpt-oss-120b      # pins the model server-side (otherwise the page's CONFIG.GROQ_MODEL is used)
# GROQ_TIMEOUT_SECONDS=40
# GROQ_MAX_COMPLETION_TOKENS=8192
# NEWS_CATEGORY=business,politics
# STALE_AFTER_MINUTES=720             # market-sensitive values older than this are labelled STALE
# STALE_AFTER_MINUTES_SLOW=10080      # same, for Fed rate / CPI / PPI
# CONSISTENCY_DISABLED_RULES=         # comma-separated rule ids to switch off, e.g. BONDS_VS_YIELDS,GOLD_VS_REAL_RATES_DOLLAR
# ALLOWED_ORIGINS=                    # extra browser origins allowed to call the API, e.g. null (file:// pages) -- see README
# ALLOWED_HOSTS=                      # extra Host header values (needed if BIND_HOST=0.0.0.0)
